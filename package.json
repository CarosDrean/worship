{
	"name": "worship",
	"private": true,
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"dev": "concurrently -k -n backend,frontend -c blue,green \"pnpm --filter @worship/backend dev\" \"pnpm --filter @worship/frontend dev\"",
		"build": "pnpm --filter @worship/frontend build",
		"server": "pnpm --filter @worship/backend start",
		"typecheck": "pnpm -r typecheck",
		"lint": "biome check .",
		"security:audit": "pnpm audit --audit-level high",
		"check": "pnpm typecheck && pnpm lint && pnpm security:audit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"concurrently": "10.0.4"
	}
}
